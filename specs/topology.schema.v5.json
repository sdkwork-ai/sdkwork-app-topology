{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdkwork.com/schemas/sdkwork.app.topology.schema.v5.json",
  "title": "SDKWork Application Runtime Topology v5",
  "type": "object",
  "additionalProperties": true,
  "not": { "required": ["cloudIngress"] },
  "required": ["schemaVersion", "kind", "appId", "applicationCode", "archetype", "vocabulary", "profileFiles", "surfaces", "orchestration"],
  "properties": {
    "schemaVersion": { "const": 5 },
    "kind": { "const": "sdkwork.app.topology" },
    "appId": { "type": "string", "pattern": "^sdkwork-[a-z0-9-]+$" },
    "applicationCode": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" },
    "archetype": { "type": "string", "enum": ["application-http-gateway", "realtime-application-platform", "application-rest-edge-device", "application-client-root"] },
    "database": false,
    "vocabulary": {
      "type": "object",
      "required": ["deploymentProfile", "environment"],
      "properties": {
        "deploymentProfile": {
          "type": "object",
          "required": ["allowed"],
          "properties": {
            "allowed": { "type": "array", "items": { "enum": ["standalone", "cloud"] }, "minItems": 1, "maxItems": 2, "uniqueItems": true }
          }
        },
        "environment": {
          "type": "object",
          "required": ["allowed"],
          "properties": {
            "allowed": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true }
          }
        }
      }
    },
    "profileFiles": {
      "type": "object",
      "patternProperties": {
        "^(standalone|cloud)\\.[a-z0-9-]+$": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "surfaces": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "connectivityPlane": { "enum": ["application", "platform", "dependency"] },
          "protocols": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
          "httpUrlEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
          "clientHttpEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
          "autostartEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
          "bindEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
          "websocketUrlEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
          "websocketPath": { "type": "string", "minLength": 1 },
          "realtimeHosting": { "enum": ["application", "platform-cloud-gateway"] },
          "realtimeLinkBindEnvs": {
            "type": "array",
            "items": { "type": "string", "pattern": "^SDKWORK_[A-Z0-9_]+_REALTIME_(TCP|UDP|QUIC)_BIND_ADDR$" },
            "uniqueItems": true
          }
        }
      }
    },
    "cloudPublicHosts": {
      "type": "object",
      "description": "Cloud public host registry per APP_RUNTIME_TOPOLOGY_NAMING.md section 9. Top-level httpHost/httpHosts is the production default; environments overrides apply per profile environment. httpHosts holds multi-base-domain host sets; httpHost must be an element of httpHosts when both are declared.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "httpHost": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)*\\.(?:com|net|org|dev|io|cn|example|internal)$" },
          "httpHosts": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)*\\.(?:com|net|org|dev|io|cn|example|internal)$" }
          },
          "websocketHost": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)*\\.(?:com|net|org|dev|io|cn|example|internal)$" },
          "note": { "type": "string" },
          "environments": {
            "type": "object",
            "patternProperties": {
              "^(development|test|staging|production|demo)$": {
                "type": "object",
                "properties": {
                  "httpHost": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)*\\.(?:com|net|org|dev|io|cn|example|internal)$" },
                  "httpHosts": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)*\\.(?:com|net|org|dev|io|cn|example|internal)$" }
                  },
                  "websocketHost": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)*\\.(?:com|net|org|dev|io|cn|example|internal)$" }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "orchestration": {
      "type": "object",
      "required": ["profiles"],
      "properties": {
        "profiles": {
          "type": "object",
          "patternProperties": {
            "^(standalone|cloud)\\.[a-z0-9-]+$": {
              "type": "object",
              "properties": {
                "processes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["id", "role"],
                    "properties": {
                      "id": { "type": "string", "minLength": 1 },
                      "applicationRoot": { "type": "string", "minLength": 1 },
                      "role": { "enum": ["client", "api-standalone-gateway", "edge-runtime", "database", "redis", "migration", "seed", "worker", "tunnel"] },
                      "script": { "type": "string", "minLength": 1 },
                      "decisionRef": { "type": "string", "pattern": "^docs/(adr|architecture/decisions)/[A-Za-z0-9._/-]+\\.md$" },
                      "bindEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
                      "runtimeTargets": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": { "type": "string" }
                      },
                      "clientArchitectures": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": {
                          "enum": ["pc-web", "h5", "capacitor", "flutter", "tauri", "electron", "android-native", "ios-native", "harmony-native", "mini-program"]
                        }
                      }
                    },
                    "allOf": [
                      {
                        "if": { "properties": { "role": { "const": "edge-runtime" } }, "required": ["role"] },
                        "then": {
                          "required": ["script", "decisionRef"],
                          "properties": {
                            "script": { "pattern": "^_sdkwork:runtime:[a-z0-9][a-z0-9:-]*$" }
                          }
                        }
                      }
                    ]
                  }
                },
                "accessEndpoints": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["id", "kind", "source", "path"],
                    "properties": {
                      "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
                      "kind": { "enum": ["user-interface", "api-reference", "health", "service"] },
                      "source": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "processId": { "type": "string", "minLength": 1 },
                          "surfaceId": { "type": "string", "minLength": 1 }
                        },
                        "oneOf": [
                          { "required": ["processId"] },
                          { "required": ["surfaceId"] }
                        ]
                      },
                      "path": { "type": "string", "pattern": "^/" },
                      "primary": { "type": "boolean" },
                      "runtimeTargets": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": { "type": "string" }
                      },
                      "clientArchitectures": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": {
                          "enum": ["pc-web", "h5", "capacitor", "flutter", "tauri", "electron", "android-native", "ios-native", "harmony-native", "mini-program"]
                        }
                      }
                    }
                  }
                },
                "browserDeliveries": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["id", "applicationRoot", "clientArchitectures", "originMode", "deliveryMode", "apiSurfaceId"],
                    "properties": {
                      "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
                      "applicationRoot": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$" },
                      "clientArchitectures": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": {
                          "enum": ["pc-web", "h5", "capacitor", "flutter", "tauri", "electron", "android-native", "ios-native", "harmony-native", "mini-program"]
                        }
                      },
                      "originMode": { "const": "same-origin" },
                      "deliveryMode": { "enum": ["dev-server-proxy", "gateway-static"] },
                      "apiSurfaceId": { "const": "application.public-ingress" },
                      "clientProcessId": { "type": "string", "minLength": 1 },
                      "hostProcessId": { "type": "string", "minLength": 1 },
                      "preserveCanonicalPaths": { "type": "boolean" },
                      "buildOutput": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$" },
                      "runtimeRootEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
                      "mountPath": { "const": "/" },
                      "spaFallback": { "const": "/index.html" },
                      "renderers": {
                        "type": "object",
                        "additionalProperties": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["applicationRoot"],
                          "properties": {
                            "applicationRoot": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$" },
                            "command": { "type": "string", "minLength": 1 },
                            "args": { "type": "array", "items": { "type": "string" } },
                            "script": { "type": "string", "minLength": 1 },
                            "package": { "type": "string", "minLength": 1 },
                            "crate": { "type": "string", "minLength": 1 },
                            "defaultPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
                            "portEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
                            "hostEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
                            "userAgent": { "type": "string", "minLength": 1 },
                            "env": { "type": "object", "additionalProperties": { "type": "string" } }
                          }
                        }
                      },
                      "deviceOverrides": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["pattern", "deviceClass"],
                          "properties": {
                            "pattern": { "type": "string", "minLength": 1 },
                            "deviceClass": { "enum": ["mobile", "desktop"] }
                          }
                        }
                      },
                      "tabletArchitecture": { "enum": ["pc-web", "h5"] }
                    },
                    "allOf": [
                      {
                        "if": { "properties": { "deliveryMode": { "const": "dev-server-proxy" } }, "required": ["deliveryMode"] },
                        "then": {
                          "required": ["clientProcessId", "preserveCanonicalPaths"],
                          "properties": { "preserveCanonicalPaths": { "const": true } },
                          "not": {
                            "anyOf": [
                              { "required": ["hostProcessId"] },
                              { "required": ["buildOutput"] },
                              { "required": ["runtimeRootEnv"] },
                              { "required": ["mountPath"] },
                              { "required": ["spaFallback"] }
                            ]
                          }
                        }
                      },
                      {
                        "if": { "properties": { "deliveryMode": { "const": "gateway-static" } }, "required": ["deliveryMode"] },
                        "then": {
                          "required": ["hostProcessId", "buildOutput", "runtimeRootEnv", "mountPath", "spaFallback"],
                          "not": {
                            "anyOf": [
                              { "required": ["clientProcessId"] },
                              { "required": ["preserveCanonicalPaths"] },
                              { "required": ["renderers"] },
                              { "required": ["deviceOverrides"] },
                              { "required": ["tabletArchitecture"] }
                            ]
                          }
                        }
                      }
                    ]
                  }
                },
                "managedResources": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["id", "driver"],
                    "properties": {
                      "id": { "type": "string", "minLength": 1 },
                      "driver": { "enum": ["windows-wsl-tcp-portproxy"] },
                      "enabledEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
                      "listenAddressEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
                      "listenAddress": { "type": "string", "minLength": 1 },
                      "listenPortEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
                      "listenPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
                      "distributionEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
                      "distribution": { "type": "string", "minLength": 1 }
                    }
                  }
                }
              }
            }
          },
          "additionalProperties": false
        }
      }
    }
  },
  "allOf": [
    { "if": { "properties": { "archetype": { "const": "application-http-gateway" } }, "required": ["archetype"] }, "then": { "properties": { "surfaces": { "required": ["application.public-ingress"] } } } },
    { "if": { "properties": { "archetype": { "const": "realtime-application-platform" } }, "required": ["archetype"] }, "then": { "properties": { "surfaces": { "required": ["application.public-ingress", "platform.api-gateway"] } } } },
    { "if": { "properties": { "archetype": { "const": "application-rest-edge-device" } }, "required": ["archetype"] }, "then": { "properties": { "surfaces": { "required": ["application.app-http", "edge.device-ingress", "platform.api-gateway"] } } } },
    { "if": { "properties": { "archetype": { "const": "application-client-root" } }, "required": ["archetype"] }, "then": { "properties": { "surfaces": { "required": ["platform.api-gateway"] } } } }
  ]
}
