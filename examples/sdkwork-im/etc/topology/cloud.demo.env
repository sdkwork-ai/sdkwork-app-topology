# cloud.demo — cloud independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Provisioned as its own deployment: dedicated PostgreSQL database/schema/user `sdkwork_im_demo` and a
# dedicated Redis logical DB index so no cache key collides with another shared-redis environment.
SDKWORK_IM_DEPLOYMENT_PROFILE=cloud
SDKWORK_IM_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_IM_PROFILE_ID=cloud.demo
SDKWORK_IM_WEB_DEV_INGRESS_BIND=0.0.0.0:3801

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_IM_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

# Dedicated demo public hosts (see topology.spec.json cloudPublicHosts environments["demo"]).
SDKWORK_IM_APPLICATION_PUBLIC_HTTP_URL=https://im-demo.sdkwork.com
SDKWORK_IM_APPLICATION_PUBLIC_WEBSOCKET_URL=wss://api-demo.sdkwork.com
SDKWORK_IM_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com

# Redis isolation: dedicate a logical DB index so hardcoded service prefixes (inbox:,
# session:ws_upgrade:, session:ws_frame:, idempotency, ...) never collide across environments.
SDKWORK_IM_REDIS_URL=redis://127.0.0.1:6379/9
SDKWORK_IM_REDIS_ENABLED=true

VITE_SDKWORK_IM_DEPLOYMENT_PROFILE=cloud
VITE_SDKWORK_IM_APPLICATION_PUBLIC_HTTP_URL=https://im-demo.sdkwork.com
VITE_SDKWORK_IM_APPLICATION_PUBLIC_WEBSOCKET_URL=wss://api-demo.sdkwork.com
VITE_SDKWORK_IM_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com
SDKWORK_IM_CONVERSATION_MAX_IN_MEMORY=10000
SDKWORK_IM_CONVERSATION_CACHE_MAX_BYTES=536870912

SDKWORK_IM_H5_FEEDS_OPEN_API_BASE_URL=https://api-demo.sdkwork.com
VITE_SDKWORK_IM_H5_FEEDS_OPEN_API_BASE_URL=https://api-demo.sdkwork.com
SDKWORK_CORS_ALLOWED_ORIGINS=https://im-demo.sdkwork.com,http://im-demo.sdkwork.com,https://im-demo.birdcoder.com,http://im-demo.birdcoder.com,https://im-demo.dtupay.com,http://im-demo.dtupay.com,https://im-demo.noaper.com,http://im-demo.noaper.com,https://im-demo.sdkwork.cn,http://im-demo.sdkwork.cn,https://im-demo.birdcoder.cn,http://im-demo.birdcoder.cn,https://im-demo.dtupay.cn,http://im-demo.dtupay.cn,https://im-demo.noaper.cn,http://im-demo.noaper.cn,https://im-demo.skubc.com,http://im-demo.skubc.com,https://im-demo.skubc.cn,http://im-demo.skubc.cn,https://im-demo.zowalk.com,http://im-demo.zowalk.com,https://im-demo.zowalk.cn,http://im-demo.zowalk.cn,https://im-demo.offer86.com,http://im-demo.offer86.com,https://im-demo.offer86.cn,http://im-demo.offer86.cn,https://im-demo.86offer.com,http://im-demo.86offer.com,https://im-demo.86offer.cn,http://im-demo.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
