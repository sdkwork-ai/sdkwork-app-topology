# standalone.development (default dev + CI smoke)
SDKWORK_IM_DEPLOYMENT_PROFILE=standalone
SDKWORK_IM_ENVIRONMENT=development
SDKWORK_ENV=dev
SDKWORK_IM_PROFILE_ID=standalone.development
SDKWORK_DATABASE_TEMPORARY_ANY_POOL_EXCEPTION=true
SDKWORK_DATABASE_TEMPORARY_DRIVER_POOL_COUNT=2

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_IM_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

SDKWORK_IM_APPLICATION_PUBLIC_INGRESS_BIND=0.0.0.0:18089
SDKWORK_IM_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:18089
SDKWORK_IM_APPLICATION_PUBLIC_WEBSOCKET_URL=ws://127.0.0.1:18089
SDKWORK_IM_WEB_DEV_INGRESS_BIND=0.0.0.0:3801
SDKWORK_IM_BROWSER_ORIGINS=http://im-dev.sdkwork.com:3801,http://127.0.0.1:3801,http://localhost:3801
SDKWORK_IM_STANDALONE_GATEWAY_ENVIRONMENT=development

# Agents embedded plane: dev inline auth bypass keeps the agents runtime on
# in-memory fixtures for local development instead of the production postgres
# schema bootstrap (which drift-checks a shared deployment database). The
# security guard rejects this flag in production-like environments only.
SDKWORK_AGENTS_DEV_AUTH_BYPASS=DEPLOY_INJECT:provide-at-deploy-time

# Multi-transport realtime link listeners (optional).
# Uncomment to enable TCP/UDP/QUIC transports alongside WebSocket.
# Client SDK selects transport via ImSdkClientOptions.transport / transportPolicy.
# SDKWORK_IM_REALTIME_TCP_BIND_ADDR=127.0.0.1:18080
# SDKWORK_IM_REALTIME_UDP_BIND_ADDR=127.0.0.1:18081
# SDKWORK_IM_REALTIME_QUIC_BIND_ADDR=127.0.0.1:18082
# SDKWORK_IM_REALTIME_QUIC_TLS_CERT_PATH=./certs/quic.crt
# SDKWORK_IM_REALTIME_QUIC_TLS_KEY_PATH=./certs/quic.key

# Per-tenant JWT signing keys are provisioned in iam_tenant_signing_key during tenant bootstrap.

SDKWORK_IM_CONVERSATION_MAX_IN_MEMORY=10000
SDKWORK_IM_CONVERSATION_CACHE_MAX_BYTES=536870912

VITE_SDKWORK_IM_DEPLOYMENT_PROFILE=standalone
VITE_SDKWORK_IM_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:3801
VITE_SDKWORK_IM_APPLICATION_PUBLIC_WEBSOCKET_URL=ws://127.0.0.1:18089

# IAM dev fixed verification code: enables verification-code login/reset in
# local development without a real messaging channel. The H5 login screen
# echoes it through the verification_code_requests devCode response.
SDKWORK_IAM_DEV_FIXED_VERIFY_CODE=654321

# Collapsed standalone single-ingress: every dependency App API is served by the IM gateway origin.
VITE_SDKWORK_IM_API_BASE_URL=http://127.0.0.1:18089
VITE_SDKWORK_DRIVE_APP_API_BASE_URL=http://127.0.0.1:18089
VITE_SDKWORK_IAM_API_BASE_URL=http://127.0.0.1:18089
VITE_SDKWORK_IM_H5_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:18089

# Community (圈子) embedded domain: anonymous public surfaces (feed.list,
# open-api reads) resolve the seeded demo tenant (100001) when no IAM context
# is present. Keep in sync with the community seed data tenant.
COMMUNITY_DEFAULT_TENANT_ID=100001
# Feeds embedded domain: anonymous open-surface stream reads (circle feeds,
# moments) resolve the same seeded tenant.
SDKWORK_FEEDS_DEFAULT_TENANT_ID=100001
# Feeds community source adapter reads circle content from the community open
# surface in-process; no HTTP base URL is configured (that would be a self-loop).

# Community commerce integration (circle tier publishing + paid-order
# verification): the standalone gateway serves the membership/order backend
# business surfaces in-process and wires the commerce ports at the composition
# root, so no backend base URL is configured here (APPLICATION_GATEWAY_SPEC
# 2.3 forbids loopback HTTP integration). The tokens below are only consulted
# when membership/order are deployed as separate processes.
# The access tokens below are a 30-day IAM session of the demo `owner` user,
# granted commerce.memberships.manage (dev). Re-mint when expired:
#   node scripts/dev/mint-community-commerce-token.mjs

SDKWORK_MEMBERSHIP_BACKEND_AUTH_TOKEN=DEPLOY_INJECT:provide-at-deploy-time
SDKWORK_MEMBERSHIP_BACKEND_ACCESS_TOKEN=DEPLOY_INJECT:provide-at-deploy-time
SDKWORK_ORDER_BACKEND_AUTH_TOKEN=DEPLOY_INJECT:provide-at-deploy-time
SDKWORK_ORDER_BACKEND_ACCESS_TOKEN=DEPLOY_INJECT:provide-at-deploy-time

# Feeds streams are served by the IM gateway origin in standalone mode
# (feeds open surface is embedded in-process, same collapsed ingress).
SDKWORK_IM_H5_FEEDS_OPEN_API_BASE_URL=http://127.0.0.1:18089
VITE_SDKWORK_IM_H5_FEEDS_OPEN_API_BASE_URL=http://127.0.0.1:18089

SDKWORK_CORS_ALLOWED_ORIGINS=http://127.0.0.1:3801,http://localhost:3801,https://im-dev.sdkwork.com,http://im-dev.sdkwork.com,https://im-dev.birdcoder.com,http://im-dev.birdcoder.com,https://im-dev.dtupay.com,http://im-dev.dtupay.com,https://im-dev.noaper.com,http://im-dev.noaper.com,https://im-dev.sdkwork.cn,http://im-dev.sdkwork.cn,https://im-dev.birdcoder.cn,http://im-dev.birdcoder.cn,https://im-dev.dtupay.cn,http://im-dev.dtupay.cn,https://im-dev.noaper.cn,http://im-dev.noaper.cn,https://im-dev.skubc.com,http://im-dev.skubc.com,https://im-dev.skubc.cn,http://im-dev.skubc.cn,https://im-dev.zowalk.com,http://im-dev.zowalk.com,https://im-dev.zowalk.cn,http://im-dev.zowalk.cn,https://im-dev.offer86.com,http://im-dev.offer86.com,https://im-dev.offer86.cn,http://im-dev.offer86.cn,https://im-dev.86offer.com,http://im-dev.86offer.com,https://im-dev.86offer.cn,http://im-dev.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
