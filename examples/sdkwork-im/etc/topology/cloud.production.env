# cloud.production
SDKWORK_IM_DEPLOYMENT_PROFILE=cloud
SDKWORK_IM_ENVIRONMENT=production
SDKWORK_IM_PROFILE_ID=cloud.production
SDKWORK_DATABASE_TEMPORARY_DRIVER_POOL_COUNT=1
SDKWORK_IM_SESSION_GATEWAY_DRAIN_TIMEOUT_SECS=45
SDKWORK_IM_SESSION_GATEWAY_WS_RATE_MAX_BUCKETS=50000

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_IM_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

SDKWORK_IM_APPLICATION_PUBLIC_HTTP_URL=https://im.sdkwork.com
SDKWORK_IM_APPLICATION_PUBLIC_WEBSOCKET_URL=wss://api.sdkwork.com
SDKWORK_IM_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com

SDKWORK_DATABASE_ENGINE=postgresql
SDKWORK_DATABASE_HOST=db.example.com
SDKWORK_DATABASE_PORT=5432
SDKWORK_DATABASE_NAME=sdkwork_ai_prod
SDKWORK_DATABASE_SCHEMA=sdkwork_ai_prod
SDKWORK_DATABASE_USERNAME=sdkwork_ai_prod
SDKWORK_DATABASE_PASSWORD_FILE=/run/secrets/sdkwork/database-password
SDKWORK_DATABASE_SSL_MODE=require
SDKWORK_DATABASE_MAX_CONNECTIONS=32
# Dynamic principal directory: IAM-authenticated users are admitted on first
# sight (recorded for audit) unless explicitly disabled — new registrations
# must be usable immediately without static catalog redeploys.
SDKWORK_IM_PRINCIPAL_DIRECTORY=postgres
SDKWORK_IM_CONVERSATION_MAX_IN_MEMORY=10000
SDKWORK_IM_CONVERSATION_CACHE_MAX_BYTES=536870912

VITE_SDKWORK_IM_DEPLOYMENT_PROFILE=cloud
VITE_SDKWORK_IM_APPLICATION_PUBLIC_HTTP_URL=https://im.sdkwork.com
VITE_SDKWORK_IM_APPLICATION_PUBLIC_WEBSOCKET_URL=wss://api.sdkwork.com
VITE_SDKWORK_IM_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com

# Optional session-gateway HA (multi-node realtime plane)
# Internal HTTP service binds are deployment-internal and owned by orchestration.
# SDKWORK_IM_REALTIME_NODE_ID=session_gateway_prod_1
# SDKWORK_IM_REALTIME_CLUSTER_BUS_SECRET=/run/secrets/sdkwork/realtime-cluster-bus-secret
# SDKWORK_IM_REALTIME_CLUSTER_BUS_URL=redis://redis.internal:6379
# Durable IM core (required in production - session-gateway fails closed without this)
# SDKWORK_DATABASE_URL=postgres://sdkwork_ai_prod@db.example.com:5432/sdkwork_ai_prod?sslmode=require
# SDKWORK_IM_CONVERSATION_STATE_CURSOR_HS256_SECRET_FILE=/run/secrets/sdkwork/conversation-state-cursor-hs256.secret
# SDKWORK_IM_FRIEND_REQUEST_CURSOR_HS256_SECRET_FILE=/run/secrets/sdkwork/friend-request-cursor-hs256.secret
# SDKWORK_IM_MESSAGE_HISTORY_CURSOR_HS256_SECRET_FILE=/run/secrets/sdkwork/message-history-cursor-hs256.secret
# SDKWORK_IM_SESSION_GATEWAY_RPC_BIND_ADDR=127.0.0.1:50051
# SDKWORK_IM_SESSION_GATEWAY_RPC_PUBLIC_ENDPOINT=http://session-gateway-rpc.internal:50051

# Security hardening (see deployments/templates/server.env.example)
SDKWORK_IM_APP_CONTEXT_REQUIRE_SIGNATURE=true
SDKWORK_IM_APP_CONTEXT_SIGNATURE_SECRET_FILE=/run/secrets/sdkwork/app-context-signature-secret
SDKWORK_IM_APP_CONTEXT_JWT_TENANT_ID=100001
SDKWORK_IM_APP_CONTEXT_JWT_KEY_ID=bootstrap
SDKWORK_IM_APP_CONTEXT_JWT_SIGNING_SECRET_FILE=/run/secrets/sdkwork/jwt-signing-secret
# JWT issuer/audience allow-lists are mandatory in production; verification
# fails closed without them (im-app-context resolve_jwt_claim_policy).
SDKWORK_IM_JWT_EXPECTED_ISSUERS=https://iam.sdkwork.com
SDKWORK_IM_JWT_EXPECTED_AUDIENCES=sdkwork-im
SDKWORK_IM_JWT_REQUIRE_JTI=true
SDKWORK_IM_JWT_REPLAY_CACHE_TTL_SECS=300
SDKWORK_IM_JWT_REPLAY_REDIS_URL=redis://redis.internal:6379/0

SDKWORK_IM_H5_FEEDS_OPEN_API_BASE_URL=https://api.sdkwork.com

# Community (圈子) and feeds embedded domains: anonymous public surfaces resolve the
# seeded demo tenant (100001) when no IAM context is present.
COMMUNITY_DEFAULT_TENANT_ID=100001
SDKWORK_FEEDS_DEFAULT_TENANT_ID=100001
VITE_SDKWORK_IM_H5_FEEDS_OPEN_API_BASE_URL=https://api.sdkwork.com

SDKWORK_CORS_ALLOWED_ORIGINS=https://im.sdkwork.com,https://im.birdcoder.com,https://im.dtupay.com,https://im.noaper.com,https://im.sdkwork.cn,https://im.birdcoder.cn,https://im.dtupay.cn,https://im.noaper.cn,https://im.skubc.com,https://im.skubc.cn,https://im.zowalk.com,https://im.zowalk.cn,https://im.offer86.com,https://im.offer86.cn,https://im.86offer.com,https://im.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
