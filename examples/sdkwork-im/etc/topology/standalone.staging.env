# standalone.staging
SDKWORK_IM_DEPLOYMENT_PROFILE=standalone
SDKWORK_IM_ENVIRONMENT=staging
SDKWORK_ENV=staging
SDKWORK_IM_PROFILE_ID=standalone.staging
SDKWORK_DATABASE_TEMPORARY_ANY_POOL_EXCEPTION=true
SDKWORK_DATABASE_TEMPORARY_DRIVER_POOL_COUNT=2

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_IM_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

SDKWORK_IM_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:18079
SDKWORK_IM_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:18079
SDKWORK_IM_APPLICATION_PUBLIC_WEBSOCKET_URL=ws://127.0.0.1:18079
SDKWORK_IM_STANDALONE_GATEWAY_ENVIRONMENT=staging

# Per-tenant JWT signing keys are provisioned in iam_tenant_signing_key during tenant bootstrap.

SDKWORK_IM_CONVERSATION_MAX_IN_MEMORY=10000
SDKWORK_IM_CONVERSATION_CACHE_MAX_BYTES=536870912

VITE_SDKWORK_IM_DEPLOYMENT_PROFILE=standalone
VITE_SDKWORK_IM_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:18079
VITE_SDKWORK_IM_APPLICATION_PUBLIC_WEBSOCKET_URL=ws://127.0.0.1:18079

# Collapsed standalone single-ingress: every dependency App API is served by the IM gateway origin.
VITE_SDKWORK_IM_API_BASE_URL=http://127.0.0.1:18079
VITE_SDKWORK_DRIVE_APP_API_BASE_URL=http://127.0.0.1:18079
VITE_SDKWORK_IAM_API_BASE_URL=http://127.0.0.1:18079
VITE_SDKWORK_IM_H5_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:18079

SDKWORK_IM_H5_FEEDS_OPEN_API_BASE_URL=https://api.standalone.invalid

SDKWORK_CORS_ALLOWED_ORIGINS=https://im-staging.sdkwork.com,http://im-staging.sdkwork.com,https://im-staging.birdcoder.com,http://im-staging.birdcoder.com,https://im-staging.dtupay.com,http://im-staging.dtupay.com,https://im-staging.noaper.com,http://im-staging.noaper.com,https://im-staging.sdkwork.cn,http://im-staging.sdkwork.cn,https://im-staging.birdcoder.cn,http://im-staging.birdcoder.cn,https://im-staging.dtupay.cn,http://im-staging.dtupay.cn,https://im-staging.noaper.cn,http://im-staging.noaper.cn,https://im-staging.skubc.com,http://im-staging.skubc.com,https://im-staging.skubc.cn,http://im-staging.skubc.cn,https://im-staging.zowalk.com,http://im-staging.zowalk.com,https://im-staging.zowalk.cn,http://im-staging.zowalk.cn,https://im-staging.offer86.com,http://im-staging.offer86.com,https://im-staging.offer86.cn,http://im-staging.offer86.cn,https://im-staging.86offer.com,http://im-staging.86offer.com,https://im-staging.86offer.cn,http://im-staging.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
