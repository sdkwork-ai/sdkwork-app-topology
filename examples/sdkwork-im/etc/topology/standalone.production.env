# standalone.production
SDKWORK_IM_DEPLOYMENT_PROFILE=standalone
SDKWORK_IM_ENVIRONMENT=production
SDKWORK_IM_PROFILE_ID=standalone.production
SDKWORK_DATABASE_TEMPORARY_ANY_POOL_EXCEPTION=true
SDKWORK_DATABASE_TEMPORARY_DRIVER_POOL_COUNT=2
SDKWORK_IM_SESSION_GATEWAY_WS_RATE_MAX_BUCKETS=50000

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_IM_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

SDKWORK_IM_APPLICATION_PUBLIC_INGRESS_BIND=0.0.0.0:18079
SDKWORK_IM_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:18079
SDKWORK_IM_APPLICATION_PUBLIC_WEBSOCKET_URL=ws://127.0.0.1:18079
SDKWORK_IM_STANDALONE_GATEWAY_ENVIRONMENT=production

SDKWORK_DATABASE_ENGINE=postgresql
SDKWORK_DATABASE_HOST=db.example.com
SDKWORK_DATABASE_PORT=5432
SDKWORK_DATABASE_NAME=sdkwork_ai_prod
SDKWORK_DATABASE_SCHEMA=sdkwork_ai_prod
SDKWORK_DATABASE_USERNAME=sdkwork_ai_prod
SDKWORK_DATABASE_PASSWORD_FILE=/etc/sdkwork/database/database.secret
SDKWORK_DATABASE_SSL_MODE=require
SDKWORK_DATABASE_MAX_CONNECTIONS=20
# Dynamic principal directory: IAM-authenticated users are admitted on first
# sight (recorded for audit) unless explicitly disabled — new registrations
# must be usable immediately without static catalog redeploys.
SDKWORK_IM_PRINCIPAL_DIRECTORY=postgres
SDKWORK_IM_CONVERSATION_MAX_IN_MEMORY=10000
SDKWORK_IM_CONVERSATION_CACHE_MAX_BYTES=536870912

VITE_SDKWORK_IM_DEPLOYMENT_PROFILE=standalone
VITE_SDKWORK_IM_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:18079
VITE_SDKWORK_IM_APPLICATION_PUBLIC_WEBSOCKET_URL=ws://127.0.0.1:18079

# Security hardening (see deployments/templates/server.env.example)
SDKWORK_IM_APP_CONTEXT_REQUIRE_SIGNATURE=true
SDKWORK_IM_APP_CONTEXT_SIGNATURE_SECRET_FILE=/etc/sdkwork/im/app-context-signature.secret
SDKWORK_IM_APP_CONTEXT_JWT_TENANT_ID=100001
SDKWORK_IM_APP_CONTEXT_JWT_KEY_ID=bootstrap
SDKWORK_IM_APP_CONTEXT_JWT_SIGNING_SECRET_FILE=/etc/sdkwork/im/jwt-signing.secret
# JWT issuer/audience allow-lists are mandatory in production; verification
# fails closed without them (im-app-context resolve_jwt_claim_policy).
SDKWORK_IM_JWT_EXPECTED_ISSUERS=https://iam.sdkwork.com
SDKWORK_IM_JWT_EXPECTED_AUDIENCES=sdkwork-im
SDKWORK_IM_JWT_REQUIRE_JTI=true
SDKWORK_IM_JWT_REPLAY_CACHE_TTL_SECS=300
SDKWORK_IM_JWT_REPLAY_REDIS_URL=redis://redis.internal:6379/0

# Collapsed standalone single-ingress: every dependency App API is served by the IM gateway origin.
VITE_SDKWORK_IM_API_BASE_URL=http://127.0.0.1:18079
VITE_SDKWORK_DRIVE_APP_API_BASE_URL=http://127.0.0.1:18079
VITE_SDKWORK_IAM_API_BASE_URL=http://127.0.0.1:18079
VITE_SDKWORK_IM_H5_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:18079

SDKWORK_IM_H5_FEEDS_OPEN_API_BASE_URL=http://127.0.0.1:18095

SDKWORK_IM_PC_STATIC_ROOT=/usr/share/sdkwork/im/web/pc
SDKWORK_CORS_ALLOWED_ORIGINS=https://im.sdkwork.com,https://im.birdcoder.com,https://im.dtupay.com,https://im.noaper.com,https://im.sdkwork.cn,https://im.birdcoder.cn,https://im.dtupay.cn,https://im.noaper.cn,https://im.skubc.com,https://im.skubc.cn,https://im.zowalk.com,https://im.zowalk.cn,https://im.offer86.com,https://im.offer86.cn,https://im.86offer.com,https://im.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
