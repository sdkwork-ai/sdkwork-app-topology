# cloud.staging
SDKWORK_IM_DEPLOYMENT_PROFILE=cloud
SDKWORK_IM_ENVIRONMENT=staging
SDKWORK_IM_PROFILE_ID=cloud.staging
SDKWORK_DATABASE_TEMPORARY_DRIVER_POOL_COUNT=1

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_IM_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

SDKWORK_IM_APPLICATION_PUBLIC_HTTP_URL=https://im-staging.sdkwork.com
SDKWORK_IM_APPLICATION_PUBLIC_WEBSOCKET_URL=wss://api-staging.sdkwork.com
SDKWORK_IM_PLATFORM_API_GATEWAY_HTTP_URL=https://api-staging.sdkwork.com

SDKWORK_DATABASE_ENGINE=postgresql
SDKWORK_DATABASE_HOST=db-staging.example.com
SDKWORK_DATABASE_PORT=5432
SDKWORK_DATABASE_NAME=sdkwork_ai_staging
SDKWORK_DATABASE_SCHEMA=sdkwork_ai_staging
SDKWORK_DATABASE_USERNAME=sdkwork_ai_staging
SDKWORK_DATABASE_PASSWORD_FILE=/run/secrets/sdkwork/database-password
SDKWORK_DATABASE_SSL_MODE=require
SDKWORK_DATABASE_MAX_CONNECTIONS=24
SDKWORK_IM_CONVERSATION_MAX_IN_MEMORY=10000
SDKWORK_IM_CONVERSATION_CACHE_MAX_BYTES=536870912

VITE_SDKWORK_IM_DEPLOYMENT_PROFILE=cloud
VITE_SDKWORK_IM_APPLICATION_PUBLIC_HTTP_URL=https://im-staging.sdkwork.com
VITE_SDKWORK_IM_APPLICATION_PUBLIC_WEBSOCKET_URL=wss://api-staging.sdkwork.com
VITE_SDKWORK_IM_PLATFORM_API_GATEWAY_HTTP_URL=https://api-staging.sdkwork.com

SDKWORK_IM_APP_CONTEXT_REQUIRE_SIGNATURE=true
SDKWORK_IM_APP_CONTEXT_SIGNATURE_SECRET_FILE=/run/secrets/sdkwork/app-context-signature-secret
SDKWORK_IM_APP_CONTEXT_JWT_TENANT_ID=100001
SDKWORK_IM_APP_CONTEXT_JWT_KEY_ID=bootstrap
SDKWORK_IM_APP_CONTEXT_JWT_SIGNING_SECRET_FILE=/run/secrets/sdkwork/jwt-signing-secret
SDKWORK_IM_JWT_REQUIRE_JTI=true
SDKWORK_IM_JWT_REPLAY_CACHE_TTL_SECS=300
SDKWORK_IM_JWT_REPLAY_REDIS_URL=redis://redis-staging.internal:6379/0

SDKWORK_IM_H5_FEEDS_OPEN_API_BASE_URL=https://api.staging.invalid

# Community (圈子) and feeds embedded domains: anonymous public surfaces resolve the
# seeded demo tenant (100001) when no IAM context is present.
COMMUNITY_DEFAULT_TENANT_ID=100001
SDKWORK_FEEDS_DEFAULT_TENANT_ID=100001
VITE_SDKWORK_IM_H5_FEEDS_OPEN_API_BASE_URL=https://api.staging.invalid

SDKWORK_CORS_ALLOWED_ORIGINS=https://im-staging.sdkwork.com,http://im-staging.sdkwork.com,https://im-staging.birdcoder.com,http://im-staging.birdcoder.com,https://im-staging.dtupay.com,http://im-staging.dtupay.com,https://im-staging.noaper.com,http://im-staging.noaper.com,https://im-staging.sdkwork.cn,http://im-staging.sdkwork.cn,https://im-staging.birdcoder.cn,http://im-staging.birdcoder.cn,https://im-staging.dtupay.cn,http://im-staging.dtupay.cn,https://im-staging.noaper.cn,http://im-staging.noaper.cn,https://im-staging.skubc.com,http://im-staging.skubc.com,https://im-staging.skubc.cn,http://im-staging.skubc.cn,https://im-staging.zowalk.com,http://im-staging.zowalk.com,https://im-staging.zowalk.cn,http://im-staging.zowalk.cn,https://im-staging.offer86.com,http://im-staging.offer86.com,https://im-staging.offer86.cn,http://im-staging.offer86.cn,https://im-staging.86offer.com,http://im-staging.86offer.com,https://im-staging.86offer.cn,http://im-staging.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
