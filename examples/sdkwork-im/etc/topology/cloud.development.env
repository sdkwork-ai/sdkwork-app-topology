# cloud.development
SDKWORK_IM_DEPLOYMENT_PROFILE=cloud
SDKWORK_IM_ENVIRONMENT=development
SDKWORK_IM_PROFILE_ID=cloud.development
SDKWORK_IM_WEB_DEV_INGRESS_BIND=0.0.0.0:3801

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_IM_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

SDKWORK_IM_APPLICATION_PUBLIC_HTTP_URL=http://im-dev.sdkwork.com:3801
SDKWORK_IM_APPLICATION_PUBLIC_WEBSOCKET_URL=wss://api-dev.sdkwork.com
SDKWORK_IM_PLATFORM_API_GATEWAY_HTTP_URL=https://api-dev.sdkwork.com

# Multi-transport realtime link listeners (optional).
# Uncomment to enable TCP/UDP/QUIC transports alongside WebSocket.
# SDKWORK_IM_REALTIME_TCP_BIND_ADDR=127.0.0.1:18080
# SDKWORK_IM_REALTIME_UDP_BIND_ADDR=127.0.0.1:18081
# SDKWORK_IM_REALTIME_QUIC_BIND_ADDR=127.0.0.1:18082
# SDKWORK_IM_REALTIME_QUIC_TLS_CERT_PATH=./certs/quic.crt
# SDKWORK_IM_REALTIME_QUIC_TLS_KEY_PATH=./certs/quic.key

# VITE block = build surface (deployed cloud bundle). Must use the domain edges
# (same convention as cloud.test/staging/production): the platform gateway key
# resolves to the api-dev edge, and application-public HTTP keys carry no dev-port.
# Cloud realtime WebSocket rides the platform api edge (the SDK base domain,
# api-dev.sdkwork.com), NOT the application web ingress edge: the im-* edge only
# proxies /api/ and serves static files, so a WS handshake there fails with 200.
# The :3801 / 127.0.0.1:3900 bindings above are dev-process/dev-server concerns
# (SDKWORK_IM_WEB_DEV_INGRESS_BIND, SDKWORK_LOCAL_PLATFORM_API_GATEWAY_HTTP_URL)
# and must not leak into VITE build values.
VITE_SDKWORK_IM_DEPLOYMENT_PROFILE=cloud
VITE_SDKWORK_IM_APPLICATION_PUBLIC_HTTP_URL=http://im-dev.sdkwork.com
VITE_SDKWORK_IM_APPLICATION_PUBLIC_WEBSOCKET_URL=wss://api-dev.sdkwork.com
VITE_SDKWORK_IM_PLATFORM_API_GATEWAY_HTTP_URL=https://api-dev.sdkwork.com
SDKWORK_IM_CONVERSATION_MAX_IN_MEMORY=10000
SDKWORK_IM_CONVERSATION_CACHE_MAX_BYTES=536870912

SDKWORK_IM_H5_FEEDS_OPEN_API_BASE_URL=https://api-dev.sdkwork.com

# Community (圈子) and feeds embedded domains: anonymous public surfaces resolve the
# seeded demo tenant (100001) when no IAM context is present.
COMMUNITY_DEFAULT_TENANT_ID=100001
SDKWORK_FEEDS_DEFAULT_TENANT_ID=100001
VITE_SDKWORK_IM_H5_FEEDS_OPEN_API_BASE_URL=https://api-dev.sdkwork.com


# dev:cloud local debugging override (vite dev surface only; PNPM_SCRIPT_SPEC section 3).
# The domain edges above stay authoritative for cloud-mode builds and deployed
# services. The development runtime instead binds every gateway-attached base
# URL to the sdkwork-api-cloud-gateway started by its own dev command
# (bind 127.0.0.1:3900), so dev:cloud quick-starts and debugs against the
# local gateway process.
SDKWORK_LOCAL_PLATFORM_API_GATEWAY_HTTP_URL=http://127.0.0.1:3900
SDKWORK_CORS_ALLOWED_ORIGINS=http://127.0.0.1:3801,http://localhost:3801,https://im-dev.sdkwork.com,http://im-dev.sdkwork.com,https://im-dev.birdcoder.com,http://im-dev.birdcoder.com,https://im-dev.dtupay.com,http://im-dev.dtupay.com,https://im-dev.noaper.com,http://im-dev.noaper.com,https://im-dev.sdkwork.cn,http://im-dev.sdkwork.cn,https://im-dev.birdcoder.cn,http://im-dev.birdcoder.cn,https://im-dev.dtupay.cn,http://im-dev.dtupay.cn,https://im-dev.noaper.cn,http://im-dev.noaper.cn,https://im-dev.skubc.com,http://im-dev.skubc.com,https://im-dev.skubc.cn,http://im-dev.skubc.cn,https://im-dev.zowalk.com,http://im-dev.zowalk.com,https://im-dev.zowalk.cn,http://im-dev.zowalk.cn,https://im-dev.offer86.com,http://im-dev.offer86.com,https://im-dev.offer86.cn,http://im-dev.offer86.cn,https://im-dev.86offer.com,http://im-dev.86offer.com,https://im-dev.86offer.cn,http://im-dev.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
