# standalone.demo — independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Provisioned as its own deployment: dedicated PostgreSQL database/schema/user `sdkwork_im_demo`
# and a dedicated Redis logical DB index (see SDKWORK_IM_REDIS_URL below) so that no cache key
# (rate-limit, session, inbox, idempotency) ever collides with another shared-redis environment.
SDKWORK_IM_DEPLOYMENT_PROFILE=standalone
SDKWORK_IM_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_IM_PROFILE_ID=standalone.demo
SDKWORK_DATABASE_TEMPORARY_ANY_POOL_EXCEPTION=true
SDKWORK_DATABASE_TEMPORARY_DRIVER_POOL_COUNT=2

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_IM_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

# Dedicated demo ingress bind/ports (kept apart from development 18089 and test 18079, so a
# meaningfully distinct origin can be published externally for system demonstrations).
SDKWORK_IM_APPLICATION_PUBLIC_INGRESS_BIND=0.0.0.0:18073
SDKWORK_IM_APPLICATION_PUBLIC_HTTP_URL=http://im-demo.sdkwork.com:18073
SDKWORK_IM_APPLICATION_PUBLIC_WEBSOCKET_URL=ws://im-demo.sdkwork.com:18073
SDKWORK_IM_WEB_DEV_INGRESS_BIND=0.0.0.0:3801
SDKWORK_IM_BROWSER_ORIGINS=http://im-demo.sdkwork.com:18073,http://127.0.0.1:18073,http://localhost:18073
SDKWORK_IM_STANDALONE_GATEWAY_ENVIRONMENT=demo

# Redis isolation: point the demo at a dedicated logical DB index on the shared Redis so the
# hardcoded service prefixes (inbox:, session:ws_upgrade:, session:ws_frame:, idempotency, ...)
# remain confined to this environment and can never collide with dev/test/staging/prod.
SDKWORK_IM_REDIS_URL=redis://127.0.0.1:6379/9
SDKWORK_IM_REDIS_ENABLED=true

SDKWORK_IM_CONVERSATION_MAX_IN_MEMORY=10000
SDKWORK_IM_CONVERSATION_CACHE_MAX_BYTES=536870912

VITE_SDKWORK_IM_DEPLOYMENT_PROFILE=standalone
VITE_SDKWORK_IM_APPLICATION_PUBLIC_HTTP_URL=http://im-demo.sdkwork.com:18073
VITE_SDKWORK_IM_APPLICATION_PUBLIC_WEBSOCKET_URL=ws://im-demo.sdkwork.com:18073

# IAM dev fixed verification code (see standalone.development.env) for demo sign-in flows.
SDKWORK_IAM_DEV_FIXED_VERIFY_CODE=654321

# Collapsed standalone single-ingress served from the dedicated demo origin.
VITE_SDKWORK_IM_API_BASE_URL=http://im-demo.sdkwork.com:18073
VITE_SDKWORK_DRIVE_APP_API_BASE_URL=http://im-demo.sdkwork.com:18073
VITE_SDKWORK_IAM_API_BASE_URL=http://im-demo.sdkwork.com:18073
VITE_SDKWORK_IM_H5_APPLICATION_PUBLIC_HTTP_URL=http://im-demo.sdkwork.com:18073

SDKWORK_IM_H5_FEEDS_OPEN_API_BASE_URL=http://im-demo.sdkwork.com:18073
VITE_SDKWORK_IM_H5_FEEDS_OPEN_API_BASE_URL=http://im-demo.sdkwork.com:18073
SDKWORK_CORS_ALLOWED_ORIGINS=https://im-demo.sdkwork.com,http://im-demo.sdkwork.com,https://im-demo.birdcoder.com,http://im-demo.birdcoder.com,https://im-demo.dtupay.com,http://im-demo.dtupay.com,https://im-demo.noaper.com,http://im-demo.noaper.com,https://im-demo.sdkwork.cn,http://im-demo.sdkwork.cn,https://im-demo.birdcoder.cn,http://im-demo.birdcoder.cn,https://im-demo.dtupay.cn,http://im-demo.dtupay.cn,https://im-demo.noaper.cn,http://im-demo.noaper.cn,https://im-demo.skubc.com,http://im-demo.skubc.com,https://im-demo.skubc.cn,http://im-demo.skubc.cn,https://im-demo.zowalk.com,http://im-demo.zowalk.com,https://im-demo.zowalk.cn,http://im-demo.zowalk.cn,https://im-demo.offer86.com,http://im-demo.offer86.com,https://im-demo.offer86.cn,http://im-demo.offer86.cn,https://im-demo.86offer.com,http://im-demo.86offer.com,https://im-demo.86offer.cn,http://im-demo.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
