              "flutter"
            ],
            "required": true
          }
        ],
        "browserDeliveries": [
          {
            "id": "im-adaptive-web",
            "applicationRoot": "apps/sdkwork-im-pc",
            "clientArchitectures": [
              "pc-web",
              "h5"
            ],
