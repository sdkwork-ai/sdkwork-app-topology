  "packaging": {
    "cloudConfigFiles": [],
    "targets": [
      {
        "id": "linux-x64-standalone-gateway-tar-gz",
        "profile": "standalone",
        "platform": "linux",
        "architecture": "x64",
        "formats": [
          "tar.gz"
        ],
        "surface": "application.public-ingress"
