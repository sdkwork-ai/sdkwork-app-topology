                  "{host}",
                  "--port",
                  "{port}",
                  "--strictPort"
                ],
                "defaultPort": 4178,
                "portEnv": "SDKWORK_IM_H5_INTERNAL_DEV_PORT",
                "env": {
                  "VITE_SDKWORK_IM_API_BASE_URL": "{httpOrigin}",
                  "VITE_SDKWORK_DRIVE_APP_API_BASE_URL": "{httpOrigin}",
                  "VITE_SDKWORK_IAM_API_BASE_URL": "{httpOrigin}",
                  "VITE_SDKWORK_IM_PLATFORM_API_GATEWAY_HTTP_URL": "{httpOrigin}",
                  "VITE_SDKWORK_IM_H5_APPLICATION_PUBLIC_HTTP_URL": "{httpOrigin}"
                }
              }
            }
          }
        ],
        "accessEndpoints": [
          {
            "id": "im-web",
            "kind": "user-interface",
            "source": {
              "processId": "im-browser"
            },
            "path": "/",
            "primary": true,
            "runtimeTargets": [
              "browser"
            ],
            "clientArchitectures": [
              "pc-web",
              "h5"
            ]
          }
        ],
        "healthSurfaces": [
          "application.public-ingress",
          "platform.api-gateway"
        ]
      },
      "standalone.test": {
        "processes": [],
        "healthSurfaces": [],
        "browserDeliveries": []
      },
      "standalone.staging": {
        "processes": [],
        "healthSurfaces": [],
        "browserDeliveries": []
      },
      "standalone.production": {
        "processes": [
          {
            "id": "standalone-gateway",
            "role": "api-standalone-gateway",
            "script": "_sdkwork:gateway:standalone",
            "required": true
          }
        ],
        "healthSurfaces": [],
        "browserDeliveries": [
          {
            "id": "im-static-pc-web",
            "applicationRoot": "apps/sdkwork-im-pc",
            "clientArchitectures": [
              "pc-web"
            ],
            "originMode": "same-origin",
            "deliveryMode": "gateway-static",
            "apiSurfaceId": "application.public-ingress",
            "hostProcessId": "standalone-gateway",
            "buildOutput": "apps/sdkwork-im-pc/dist",
            "runtimeRootEnv": "SDKWORK_IM_PC_STATIC_ROOT",
            "mountPath": "/",
            "spaFallback": "/index.html"
          },
          {
            "id": "im-static-h5",
            "applicationRoot": "apps/sdkwork-im-pc",
            "clientArchitectures": [
              "h5"
            ],
            "originMode": "same-origin",
            "deliveryMode": "gateway-static",
            "apiSurfaceId": "application.public-ingress",
            "hostProcessId": "standalone-gateway",
            "buildOutput": "apps/sdkwork-im-pc/dist",
            "runtimeRootEnv": "SDKWORK_IM_PC_STATIC_ROOT",
            "mountPath": "/",
            "spaFallback": "/index.html"
          }
        ]
      },
      "cloud.test": {
        "processes": [],
        "healthSurfaces": []
      },
      "cloud.staging": {
        "processes": [],
        "healthSurfaces": []
      },
      "cloud.production": {
        "processes": [],
        "healthSurfaces": []
      },
      "standalone.demo": {
        "processes": [],
        "healthSurfaces": [],
        "browserDeliveries": []
      },
      "cloud.demo": {
        "processes": [],
        "healthSurfaces": []
      }
