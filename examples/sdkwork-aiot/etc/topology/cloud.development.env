# cloud.development
SDKWORK_AIOT_DEPLOYMENT_PROFILE=cloud
SDKWORK_AIOT_ENVIRONMENT=development
SDKWORK_AIOT_PROFILE_ID=cloud.development
SDKWORK_AIOT_APPLICATION_APP_HTTP_URL=https://api-dev.sdkwork.com/app/v3/api/iot
SDKWORK_AIOT_APPLICATION_ADMIN_HTTP_URL=https://api-dev.sdkwork.com/backend/v3/api/iot
SDKWORK_AIOT_EDGE_DEVICE_INGRESS_HTTP_URL=https://edge-dev.aiot.sdkwork.com
SDKWORK_AIOT_EDGE_DEVICE_INGRESS_WEBSOCKET_URL=wss://edge-dev.aiot.sdkwork.com
SDKWORK_AIOT_PLATFORM_API_GATEWAY_HTTP_URL=https://api-dev.sdkwork.com
SDKWORK_AIOT_APPLICATION_PUBLIC_HTTP_URL=https://api-dev.sdkwork.com
VITE_SDKWORK_AIOT_DEPLOYMENT_PROFILE=cloud
VITE_SDKWORK_AIOT_ENVIRONMENT=development
VITE_SDKWORK_AIOT_APPLICATION_APP_HTTP_URL=https://api-dev.sdkwork.com/app/v3/api/iot
VITE_SDKWORK_AIOT_APPLICATION_ADMIN_HTTP_URL=https://api-dev.sdkwork.com/backend/v3/api/iot
VITE_SDKWORK_AIOT_EDGE_DEVICE_INGRESS_HTTP_URL=https://edge-dev.aiot.sdkwork.com
VITE_SDKWORK_AIOT_EDGE_DEVICE_INGRESS_WEBSOCKET_URL=wss://edge-dev.aiot.sdkwork.com
VITE_SDKWORK_AIOT_PLATFORM_API_GATEWAY_HTTP_URL=https://api-dev.sdkwork.com
VITE_SDKWORK_AIOT_APPLICATION_PUBLIC_HTTP_URL=https://api-dev.sdkwork.com
VITE_SDKWORK_DRIVE_APP_API_BASE_URL=https://api-dev.sdkwork.com
VITE_SDKWORK_AGENTS_APP_API_BASE_URL=https://agents-dev.sdkwork.com
VITE_SDKWORK_VOICE_APP_API_BASE_URL=https://voice-dev.sdkwork.com
VITE_SDKWORK_AIOT_AGENTS_DEFAULT_AGENT_ID=agent.aiot.assistant

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_AIOT_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
SDKWORK_AIOT_WEB_DEV_INGRESS_BIND=127.0.0.1:5174
SDKWORK_AIOT_PC_INTERNAL_DEV_PORT=5175
SDKWORK_AIOT_H5_INTERNAL_DEV_PORT=5176


# dev:cloud local debugging override (vite dev surface only; PNPM_SCRIPT_SPEC section 3).
# The domain edges above stay authoritative for cloud-mode builds and deployed
# services. The development runtime instead binds every gateway-attached base
# URL to the sdkwork-api-cloud-gateway started by its own dev command
# (bind 127.0.0.1:3900), so dev:cloud quick-starts and debugs against the
# local gateway process.
SDKWORK_LOCAL_PLATFORM_API_GATEWAY_HTTP_URL=http://127.0.0.1:3900
