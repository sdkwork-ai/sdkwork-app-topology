# Bootstrap profile cloud.test — replace with application-specific values.
SDKWORK_AIOT_DEPLOYMENT_PROFILE=cloud
SDKWORK_AIOT_ENVIRONMENT=test
SDKWORK_AIOT_PROFILE_ID=cloud.test
SDKWORK_AIOT_APPLICATION_PUBLIC_HTTP_URL=https://aiot-test.sdkwork.com
SDKWORK_AIOT_PLATFORM_API_GATEWAY_HTTP_URL=https://api-test.sdkwork.com
# Dedicated AIoT edge device-ingress plane (naming follows the edge-*.aiot
# family used by development/demo/production env values; see cloudPublicHosts).
SDKWORK_AIOT_EDGE_DEVICE_INGRESS_WEBSOCKET_URL=wss://edge-test.aiot.sdkwork.com
VITE_SDKWORK_AIOT_EDGE_DEVICE_INGRESS_WEBSOCKET_URL=wss://edge-test.aiot.sdkwork.com
SDKWORK_AIOT_WEB_DEV_INGRESS_BIND=127.0.0.1:5174
SDKWORK_AIOT_PC_INTERNAL_DEV_PORT=5175
SDKWORK_AIOT_H5_INTERNAL_DEV_PORT=5176


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_AIOT_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

