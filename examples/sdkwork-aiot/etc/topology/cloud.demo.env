# cloud.demo — independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Provisioned as its own deployment: dedicated PostgreSQL database/schema/user `sdkwork_aiot_demo`
# and (when the base profile uses Redis) a dedicated Redis logical DB index / key prefix so no cache
# key (rate-limit, session, idempotency, ...) ever collides with another shared-redis environment.
# NOTE: demo MUST use an independent database schema `sdkwork_aiot_demo` for isolation.
# NOTE: if Redis is used, demo MUST target a dedicated Redis logical DB index / distinct key prefix so it never collides with other environments on shared Redis.
SDKWORK_AIOT_DEPLOYMENT_PROFILE=cloud
SDKWORK_AIOT_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_AIOT_PROFILE_ID=cloud.demo
SDKWORK_AIOT_APPLICATION_APP_HTTP_URL=https://api-demo.sdkwork.com/app/v3/api/iot
SDKWORK_AIOT_APPLICATION_ADMIN_HTTP_URL=https://api-demo.sdkwork.com/backend/v3/api/iot
SDKWORK_AIOT_EDGE_DEVICE_INGRESS_HTTP_URL=https://edge-demo.aiot.sdkwork.com
SDKWORK_AIOT_EDGE_DEVICE_INGRESS_WEBSOCKET_URL=wss://edge-demo.aiot.sdkwork.com
SDKWORK_AIOT_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com
SDKWORK_AIOT_APPLICATION_PUBLIC_HTTP_URL=https://api-demo.sdkwork.com
VITE_SDKWORK_AIOT_DEPLOYMENT_PROFILE=cloud
VITE_SDKWORK_AIOT_ENVIRONMENT=demo
VITE_SDKWORK_AIOT_APPLICATION_APP_HTTP_URL=https://api-demo.sdkwork.com/app/v3/api/iot
VITE_SDKWORK_AIOT_APPLICATION_ADMIN_HTTP_URL=https://api-demo.sdkwork.com/backend/v3/api/iot
VITE_SDKWORK_AIOT_EDGE_DEVICE_INGRESS_HTTP_URL=https://edge-demo.aiot.sdkwork.com
VITE_SDKWORK_AIOT_EDGE_DEVICE_INGRESS_WEBSOCKET_URL=wss://edge-demo.aiot.sdkwork.com
VITE_SDKWORK_AIOT_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com
VITE_SDKWORK_AIOT_APPLICATION_PUBLIC_HTTP_URL=https://api-demo.sdkwork.com
VITE_SDKWORK_DRIVE_APP_API_BASE_URL=https://api-demo.sdkwork.com
VITE_SDKWORK_AGENTS_APP_API_BASE_URL=https://agents-demo.sdkwork.com
VITE_SDKWORK_VOICE_APP_API_BASE_URL=https://voice-demo.sdkwork.com
VITE_SDKWORK_AIOT_AGENTS_DEFAULT_AGENT_ID=agent.aiot.assistant

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_AIOT_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
SDKWORK_AIOT_WEB_DEV_INGRESS_BIND=127.0.0.1:5174
SDKWORK_AIOT_PC_INTERNAL_DEV_PORT=5175
SDKWORK_AIOT_H5_INTERNAL_DEV_PORT=5176


